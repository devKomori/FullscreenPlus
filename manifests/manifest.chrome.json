{
  "name": "FullscreenPlus - In-window mode & volume booster",
  "short_name": "FullscreenPlus",
  "description": "Customize fullscreen to fill your browser window instead of your screen. Works on YouTube, Reddit, and more, with volume boosting.",
  "version": "3.2.0",
  "manifest_version": 3,
  "icons": {
    "16": "imgs/icon128.png",
    "48": "imgs/icon128.png",
    "128": "imgs/icon128.png"
  },
  "action": {
    "default_popup": "html/popup.html"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
        "matches": ["<all_urls>"],
        "js": ["js/fullscreen.js"],
        "run_at": "document_start",
        "world": "MAIN",
        "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["js/content.js"],
      "css": ["css/content.css"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "permissions": ["activeTab", "storage", "tabCapture", "offscreen"],
  "web_accessible_resources": [
    {
      "resources": ["html/choice.html", "css/choice.css", "js/choice.js"],
      "matches": ["<all_urls>"]
    }
  ]


}